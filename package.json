{
  "name": "aide-secure-mcp-agent",
  "version": "0.1.0",
  "private": true,
  "author": "Jahid Khan Tuhin",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aide/api --filter @aide/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @aide/api test",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:bootstrap": "pnpm --filter @aide/api db:bootstrap",
    "owner:register": "pnpm --filter @aide/api owner:register"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "typescript": "~5.9.3",
    "prettier": "^3.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
