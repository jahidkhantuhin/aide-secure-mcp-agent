    "better-auth": "^1.7.27",
    "bullmq": "^6.7.8",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "mongodb": "^7.0.0",
    "mongodb-checkpoint": "npm:mongodb@6.22.0",
    "pino-http": "^11.0.0",
