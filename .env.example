API_PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27027/aide?replicaSet=rs0
REDIS_URL=redis://localhost:6389
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Set a persistent 32+ character random secret to enable owner auth and keep
# sandbox cookies valid across API restarts. Leave it unset for local demo use.
# AIDE_SESSION_SECRET=
SANDBOX_TTL_SECONDS=3600
SANDBOX_REQUESTS_PER_MINUTE=30
SANDBOX_TOKEN_BUDGET=10000
# Public mode is mock-only and disables owner login and direct MCP endpoints.
SANDBOX_PUBLIC=false
SANDBOX_GLOBAL_REQUESTS_PER_MINUTE=300
SANDBOX_GLOBAL_TOKEN_BUDGET_PER_HOUR=100000

# Required only while running pnpm owner:register. Remove the password afterward.
# AIDE_OWNER_EMAIL=
# AIDE_OWNER_NAME=
# AIDE_OWNER_PASSWORD=

# Set to run the MongoDB integration tests on the local replica set.
# TEST_MONGODB_URI=mongodb://localhost:27027/aide?replicaSet=rs0

# Owner model provider. With no key/provider configured, Aide uses MockLLM.
# AIDE_LLM_PROVIDER=mock
# AIDE_MODEL=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Seconds to undo an approved mock action before the worker can execute it.
AIDE_UNDO_SECONDS=10
# Set alongside TEST_MONGODB_URI for worker integration tests.
# TEST_REDIS_URL=redis://localhost:6389
